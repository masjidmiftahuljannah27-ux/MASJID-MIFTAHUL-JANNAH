    <script>
        /* ================= */
        let latitude = -6.2088;
        let longitude = 106.8456;
        let timezone = 7;
        let currentMethod = "MWL";
        let latestTimes = null;

        /* ================= Clock ================= */
        function updateClock() {
            const now = new Date();
            document.getElementById("clock").innerText =
                now.toLocaleTimeString("id-ID", { hour12: false }).replace(/\./g, ":");
            document.getElementById("date").innerText =
                now.toLocaleDateString("id-ID", { weekday: "long", year: "numeric", month: "long", day: "numeric" });
        }
        setInterval(updateClock, 1000);
        updateClock();

        /* ================= City Data ================= */
        const cityData = {
            jakarta:{lat:-6.2088,lon:106.8456,tz:7,name:"Jakarta"},
            bandung:{lat:-6.9175,lon:107.6191,tz:7,name:"Bandung"},
            surabaya:{lat:-7.2504,lon:112.7688,tz:7,name:"Surabaya"},
            semarang:{lat:-6.9667,lon:110.4167,tz:7,name:"Semarang"},
            yogyakarta:{lat:-7.7972,lon:110.3688,tz:7,name:"Yogyakarta"},
            medan:{lat:3.5952,lon:98.6722,tz:7,name:"Medan"},
            makassar:{lat:-5.1477,lon:119.4327,tz:8,name:"Makassar"},
            bali:{lat:-8.3405,lon:115.0920,tz:8,name:"Bali"},
            balikpapan:{lat:-1.2654,lon:116.8312,tz:8,name:"Balikpapan"},
            palembang:{lat:-2.9909,lon:104.7567,tz:7,name:"Palembang"},
        };

        /* ================= Load Settings ================= */
        function loadSettings() {
            const saved = JSON.parse(localStorage.getItem("settings"));
            if (saved && cityData[saved.city]) {
                document.getElementById("citySelect").value = saved.city;
                document.getElementById("methodSelect").value = saved.method;
                document.getElementById("timezoneSelect").value = saved.timezone;
                document.getElementById("iqomahInput").value = saved.iqomah || 5;
                document.getElementById("sholatDurationInput").value = saved.sholatDuration || 15; 
                document.getElementById("masjidNameInput").value = saved.masjidName || "MASJID";
                document.getElementById("masjidAddressInput").value = saved.masjidAddress || "Jl. Alamat";

                applySettings(saved.city, saved.method, saved.timezone);
            } else {
                applySettings("jakarta", "MWL", 7);
            }
        }

        /* ================= Save Setting Button ================= */
        document.getElementById("saveSettings").addEventListener("click", () => {
            const city = document.getElementById("citySelect").value;
            const method = document.getElementById("methodSelect").value;
            const tz = parseInt(document.getElementById("timezoneSelect").value);
            const iqomah = parseInt(document.getElementById("iqomahInput").value);
            const sholatDuration = parseInt(document.getElementById("sholatDurationInput").value); 
            const masjidName = document.getElementById("masjidNameInput").value;
            const masjidAddress = document.getElementById("masjidAddressInput").value;

            localStorage.setItem("settings", JSON.stringify({
                city,
                method,
                timezone: tz,
                iqomah: iqomah,
                sholatDuration: sholatDuration,
                masjidName,
                masjidAddress
            }));

            applySettings(city, method, tz);
        });

        /* ================= Apply Setting ================= */
        function applySettings(city, method, tz) {
            currentMethod = method;
            latitude = cityData[city].lat;
            longitude = cityData[city].lon;
            timezone = tz;
            
            const saved = JSON.parse(localStorage.getItem("settings"));

            document.getElementById("location").innerText = cityData[city].name;
            document.getElementById("method").innerText = "Metode: " + method;
            document.getElementById("masjidName").innerText = saved?.masjidName || "MASJID";
            document.getElementById("masjidAddress").innerText = saved?.masjidAddress || "";

            loadPrayerTimes();
        }

        /* ================= Hitung Jadwal ================= */
        function loadPrayerTimes() {
            prayTimes.setMethod(currentMethod);

            const today = new Date();
            const times = prayTimes.getTimes(today, [latitude, longitude], timezone);
            
            const [fajrHour, fajrMinute] = times.fajr.split(":").map(Number);
            let imsakTime = new Date(today);
            imsakTime.setHours(fajrHour);
            imsakTime.setMinutes(fajrMinute - 10);

            const pad = (n) => (n < 10 ? "0" + n : n);
            times.imsak = pad(imsakTime.getHours()) + ":" + pad(imsakTime.getMinutes());

            latestTimes = times;
            
            document.getElementById("imsak").innerText = times.imsak;
            document.getElementById("subuh").innerText = times.fajr;
            document.getElementById("suruq").innerText = times.sunrise;
            document.getElementById("dzuhur").innerText = times.dhuhr;
            document.getElementById("ashar").innerText = times.asr;
            document.getElementById("maghrib").innerText = times.maghrib;
            document.getElementById("isya").innerText = times.isha;

            updateActivePrayer(times);
        }

        /* ================= ACTIVE PRAYER & COUNTDOWN ================= */
        function updateActivePrayer(times) {
            const now = new Date();

            const prayerOrder = [
                { key: "imsak", label: "Imsak" },
                { key: "fajr", label: "Subuh" },
                { key: "sunrise", label: "Suruq" },
                { key: "dhuhr", label: "Dzuhur" },
                { key: "asr", label: "Ashar" },
                { key: "maghrib", label: "Maghrib" },
                { key: "isha", label: "Isya" }
            ];

            let current = 0;

            for (let i = 0; i < prayerOrder.length; i++) {
                const [h, m] = times[prayerOrder[i].key].split(":").map(Number);
                const start = new Date(now.getFullYear(), now.getMonth(), now.getDate(), h, m);

                const nextIndex = (i + 1) % prayerOrder.length;
                const [nh, nm] = times[prayerOrder[nextIndex].key].split(":").map(Number);
                const end = new Date(now.getFullYear(), now.getMonth(), now.getDate(), nh, nm);

                if (nextIndex === 0 && now > start) end.setDate(end.getDate() + 1);

                if (now >= start && now < end) {
                    current = i;
                    break;
                }
            }

            const nextIdx = (current + 1) % prayerOrder.length;
            const nextPrayer = prayerOrder[nextIdx];

            document.getElementById("nextLabel").innerText = "Menuju " + nextPrayer.label;

            const [nh, nm] = times[nextPrayer.key].split(":").map(Number);
            const nextTime = new Date(now.getFullYear(), now.getMonth(), now.getDate(), nh, nm);
            if (nextIdx === 0 && now > nextTime) nextTime.setDate(nextTime.getDate() + 1);

            const diff = nextTime - now;
            const hh = String(Math.floor(diff / 3600000)).padStart(2,"0");
            const mm = String(Math.floor((diff % 3600000) / 60000)).padStart(2,"0");
            const ss = String(Math.floor((diff % 60000) / 1000)).padStart(2,"0");

            document.getElementById("countdown").innerText = `${hh}:${mm}:${ss}`;

            document.querySelectorAll("#prayer-cards .glass-card")
                .forEach(card => card.classList.remove("active-prayer"));

            document.querySelector(`[data-prayer="${prayerOrder[current].key}"]`)
                ?.classList.add("active-prayer");
            
            if (hh === "00" && mm === "00" && ss === "00") {
                if (nextPrayer.key !== "sunrise" && nextPrayer.key !== "imsak") {
                    playAdzan(nextPrayer.label);
                }
            }
        }

        setInterval(() => latestTimes && updateActivePrayer(latestTimes), 1000);
        setInterval(loadPrayerTimes, 60000);

        function playAdzan(prayerName) {
            const audio = document.getElementById("adzanAudio");
            localStorage.setItem("currentPrayer", prayerName);

            audio.currentTime = 0;
            audio.play().catch(() => console.log("Autoplay diblokir browser"));

            audio.onended = () => {
                window.location.href = "page-adzan.html";
            };
        }

        /* ================= Hadits Rotation ================= */
        let hadiths = [
            "“Sesungguhnya sholat itu mencegah dari perbuatan keji dan munkar.” (QS. Al-Ankabut: 45)",
            "“Dirikanlah sholat, sesungguhnya sholat itu adalah kewajiban yang ditentukan waktunya.” (QS. An-Nisa: 103)",
            "“Mintalah pertolongan dengan sabar dan sholat.” (QS. Al-Baqarah: 153)",
            "“Celakalah orang yang sholat, yaitu orang yang lalai dari sholatnya.” (QS. Al-Ma’un: 4–5)",
            "“Peliharalah semua sholatmu, terutama sholat tengah (Ashar).” (QS. Al-Baqarah: 238)",
            "“Dan Sujudlah serta dekatkanlah dirimu kepada Allah.” (QS. Al-Alaq: 19)",
            "“Sholat adalah tiang agama. Barangsiapa mendirikannya, ia telah menegakkan agama.” (HR. Thabrani)",
            "“Amalan pertama yang dihisab pada hari kiamat adalah sholat.” (HR. Tirmidzi)",
            "“Perjanjian antara kami dan mereka adalah sholat, siapa meninggalkannya kafir.” (HR. Tirmidzi)",
            "“Jarak antara seorang hamba dan kekufuran adalah meninggalkan sholat.” (HR. Muslim)",
            "“Yang paling dekat seorang hamba dengan Rabb-nya adalah saat sujud.” (HR. Muslim)",
            "“Sholatlah sebelum kalian dishalatkan.” (HR. Baihaqi)",
            "“Allah membentangkan tangan-Nya pada malam hari untuk mengampuni kesalahan siang hari.” (HR. Muslim)",
            "“Seseorang akan bersama dengan yang ia cintai.” (HR. Bukhari)",
            "“Barang siapa menjaga sholat, baginya cahaya dan keselamatan pada hari kiamat.” (HR. Ahmad)",
            "“Sholat berjamaah lebih utama dari sholat sendiri dengan 27 derajat.” (HR. Bukhari & Muslim)",
        ];

        let hadithIndex = 0;
        let hadithInterval = null;

        function startHadithRotation() {
            const infoCard = document.getElementById("infoCard");
            if (hadithInterval) clearInterval(hadithInterval);

            infoCard.innerText = hadiths[hadithIndex];
            hadithInterval = setInterval(() => {
                hadithIndex = (hadithIndex + 1) % hadiths.length;
                infoCard.innerText = hadiths[hadithIndex];
            }, 10000);
        }

        /* ================= Running Text Footer ================= */
        const messages = [
          "Selamat datang — Mohon menjaga ketenangan dan kebersihan.",
          "Gunakan waktu sebelum adzan untuk membaca Al-Qur'an dan dzikir.",
          "Silakan silent / matikan smartphone selama berada di dalam masjid."
        ];

        const speed = 120;
        const gap = 30;
        const container = document.getElementById('runningContainer');
        const textEl = document.getElementById('runningText');

        let idx = 0;
        let textWidth = 0;
        let containerWidth = 0;
        let x = 0;
        let lastTime = null;
        let rafId = null;

        function setMessage(i) {
          textEl.textContent = messages[i];
          textWidth = textEl.offsetWidth;
          containerWidth = container.clientWidth;
          x = containerWidth + gap;
          textEl.style.transform = `translateX(${x}px) translateY(-50%)`;
        }

        function step(timestamp) {
          if (!lastTime) lastTime = timestamp;
          const delta = (timestamp - lastTime) / 1000;
          lastTime = timestamp;

          x -= speed * delta;
          textEl.style.transform = `translateX(${Math.round(x)}px) translateY(-50%)`;

          if (x <= -textWidth) {
            idx = (idx + 1) % messages.length;
            setMessage(idx);
          }
          rafId = requestAnimationFrame(step);
        }

        function start() {
          cancelAnimationFrame(rafId);
          lastTime = null;
          setMessage(idx);
          rafId = requestAnimationFrame(step);
        }

        window.onload = function () {
            loadSettings();
            startHadithRotation();
            updateClock();
            start();
        };
    </script>
</body>
</html>
